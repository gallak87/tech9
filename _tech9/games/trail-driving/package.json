{
  "name": "trail-driving",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort --port 4480",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --strictPort --port 4481",
    "test": "node --test tests/*.test.js",
    "verify": "npm run build && node tests/driving-browser.mjs",
    "capture": "node scripts/capture.mjs",
    "assets:build": "node scripts/build-assets.mjs",
    "lint": "eslint . --max-warnings 0 && npm run format:check",
    "lint:fix": "npm run format && eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:staged": "lint-staged --cwd .",
    "verify:routes": "npm run build && node tests/route-playthrough.mjs"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{css,html,json,md}": "prettier --write"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "playwright": "1.58.2",
    "prettier": "3.9.8",
    "vite": "8.3.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "config": {
    "devPort": 4480,
    "previewPort": 4481
  },
  "tech9": {
    "modules": [
      "grounded-walking",
      "placement-collisions"
    ]
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "maxNodeModuleJsDepth": 1,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.js", "tools/**/*.mjs", "*.js", "*.mjs"],
  "exclude": ["node_modules", "dist", "shots"]
}

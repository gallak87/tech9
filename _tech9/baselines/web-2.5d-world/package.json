{
  "name": "tech9-web-2.5d-world",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort --port 4403",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --strictPort --port 4404",
    "test": "node --test tests/*.test.js",
    "verify": "node tests/browser.mjs",
    "lint": "eslint . --max-warnings 0 && npm run format:check",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint:staged": "lint-staged --cwd ."
  },
  "dependencies": {
    "pixi.js": "8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "lint-staged": "16.4.0",
    "playwright": "1.58.2",
    "prettier": "3.9.8",
    "vite": "8.3.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "config": {
    "devPort": 4403,
    "previewPort": 4404
  },
  "tech9": {
    "runtime": "web",
    "renderer": "pixi",
    "modules": [
      "sprite-world"
    ]
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{css,html,json,md}": "prettier --write"
  }
}

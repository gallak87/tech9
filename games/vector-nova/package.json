{
  "name": "vector-nova",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5179 --strictPort",
    "build": "vite build",
    "previews": "node tools/capture-menu-previews.mjs",
    "audio:setup": "python3 tools/setup-audio.py",
    "audio:generate": "python3 assets/levels/halcyon/audio/render.py",
    "audio:encode": "node tools/encode-audio.mjs",
    "sfx:setup": "python3 tools/sfx.py setup",
    "sfx:generate": "python3 tools/sfx.py generate",
    "preview": "vite preview --host 127.0.0.1 --port 5180 --strictPort",
    "verify": "node tools/frontend-verify.mjs",
    "test": "node --test 'tools/**/*.test.mjs' 'src/**/*.test.js'",
    "lint": "eslint . --max-warnings 0 && npm run format:check",
    "lint:fix": "npm run format && eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:staged": "lint-staged --cwd .",
    "prepare": "cd ../.. && husky games/vector-nova/.husky",
    "verify:orbital": "node tools/verify-level.mjs orbital",
    "check:level": "node tools/check-level.mjs",
    "verify:level": "node tools/verify-level.mjs",
    "build:demo": "node tools/desktop/build.mjs demo",
    "build:full": "node tools/desktop/build.mjs full",
    "package:demo": "node tools/desktop/package.mjs demo",
    "package:full": "node tools/desktop/package.mjs full",
    "test:desktop": "node --test tools/desktop/*.test.mjs",
    "verify:desktop": "node tools/desktop/verify.mjs",
    "steam:prepare": "node tools/desktop/steam.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@worldkit/environment": "file:../../worldkit",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@eslint/js": "10.0.1",
    "electron": "44.9.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "playwright": "1.58.2",
    "prettier": "3.9.8",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "lint-staged": {
    "*.{css,html,json,md}": "prettier --write",
    "*.{js,mjs,cjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ]
  }
}

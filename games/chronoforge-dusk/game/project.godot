; Dusk owns this project. Production sources live outside res://.
config_version=5

[application]
config/name="Chronoforge Dusk"
config/version="0.1.0"
run/max_fps=60
run/main_scene="res://development/foundation.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/description="Native foundation — diagnostic fixtures, not Kaida"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/vsync/vsync_mode=1

[rendering]
renderer/rendering_method="forward_plus"
rendering_device/driver.macos="metal"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048

[physics]
common/physics_ticks_per_second=60


[editor_plugins]
enabled=PackedStringArray("res://addons/source_hashes/plugin.cfg")

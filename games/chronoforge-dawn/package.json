{
  "name": "chronoforge-dawn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5190 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 5191 --strictPort",
    "shot": "node tools/shot.mjs",
    "probe": "node tools/probe.mjs",
    "review": "node tools/shot.mjs --w 1920 --h 1080 --quality ultra",
    "lint:rng": "node tools/lintrng.mjs",
    "forge": "node docs/phase2/forge.mjs docs/phase2/forge-manifest.json",
    "forge:test": "node docs/phase2/forge-selftest.mjs",
    "forge:setup": "bash docs/phase2/setup-3dgen.sh",
    "forge:smoke": "$HOME/miniconda3/envs/hunyuan_mlx/bin/python docs/phase2/generate.py --image docs/phase2/ref/kaida-painterly.png --output docs/phase2/out/smoke.glb --shape-only --steps 8 --octree-resolution 128 --verbose",
    "forge:shape": "$HOME/miniconda3/envs/hunyuan_mlx/bin/python docs/phase2/generate.py --image docs/phase2/ref/kaida-painterly.png --output docs/phase2/out/kaida-shape.glb --shape-only",
    "forge:full": "$HOME/miniconda3/envs/hunyuan_mlx/bin/python docs/phase2/generate.py --image docs/phase2/ref/kaida-painterly.png --output docs/phase2/out/kaida.glb",
    "forge:smoke-raw": "$HOME/miniconda3/envs/hunyuan_mlx/bin/python docs/phase2/generate.py --image docs/phase2/ref/kaida-painterly-raw.png --output docs/phase2/out/smoke-raw.glb --shape-only --steps 8 --octree-resolution 128 --verbose",
    "forge:smoke-keyed": "$HOME/miniconda3/envs/hunyuan_mlx/bin/python docs/phase2/generate.py --image docs/phase2/ref/kaida-painterly-g1.png --output docs/phase2/out/smoke-keyed.glb --shape-only --steps 8 --octree-resolution 128 --verbose",
    "forge:smoke-demo": "$HOME/miniconda3/envs/hunyuan_mlx/bin/python docs/phase2/generate.py --image docs/phase2/3d-gen/Hunyuan3D-2.1-mlx/assets/demo.png --output docs/phase2/out/smoke-demo.glb --shape-only --steps 2 --octree-resolution 128 --verbose"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "vite": "^8.2.2"
  }
}

{
  "name": "vector-nova",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5179 --strictPort",
    "build": "vite build",
    "previews": "node tools/capture-menu-previews.mjs",
    "audio:setup": "python3 tools/setup-audio.py",
    "audio:generate": "python3 assets/levels/halcyon/audio/render.py",
    "preview": "vite preview --host 127.0.0.1 --port 5180 --strictPort",
    "verify": "node tools/frontend-verify.mjs",
    "test": "node --test 'tools/**/*.test.mjs' 'src/**/*.test.js'",
    "lint": "eslint . --max-warnings 0 && npm run format:check",
    "lint:fix": "npm run format && eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:staged": "lint-staged --cwd .",
    "prepare": "cd ../.. && husky games/vector-nova/.husky",
    "verify:orbital": "node tools/verify-level.mjs orbital",
    "check:level": "node tools/check-level.mjs",
    "verify:level": "node tools/verify-level.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "playwright": "1.58.2",
    "prettier": "3.9.8",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{css,html,json,md}": "prettier --write"
  }
}

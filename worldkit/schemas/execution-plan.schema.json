{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tech9.local/schemas/execution-plan.schema.json",
  "title": "Tech9 execution plan",
  "description": "Game scope, ownership, acceptance and authority. The CLI validates the baseline version, dependency cycles and exclusive file ownership.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "pitch",
    "baselineVersion",
    "status",
    "authorization",
    "scope",
    "milestones",
    "lanes",
    "validation",
    "artGate",
    "stopAfter"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "pitch": {
      "$ref": "#/$defs/text"
    },
    "status": {
      "enum": ["draft", "approved"]
    },
    "authorization": {
      "type": "object",
      "required": ["mode", "basis"],
      "properties": {
        "mode": {
          "enum": ["delegated", "explicit"]
        },
        "basis": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "scope": {
      "type": "object",
      "required": ["mustHave", "outOfScope"],
      "properties": {
        "mustHave": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "outOfScope": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "deliverables", "acceptance"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "deliverables": {
            "$ref": "#/$defs/nonemptyStrings"
          },
          "acceptance": {
            "$ref": "#/$defs/nonemptyStrings"
          }
        }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "owns", "dependsOn"],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "role": {
            "$ref": "#/$defs/text"
          },
          "owns": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ownership"
            }
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["commands", "playthrough", "performance"],
      "properties": {
        "commands": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "playthrough": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "performance": {
          "type": "object",
          "required": ["targetFps", "viewport", "quality"],
          "properties": {
            "targetFps": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "quality": {
              "$ref": "#/$defs/text"
            },
            "viewport": {
              "type": "object",
              "required": ["width", "height"],
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "artGate": {
      "type": "object",
      "required": ["threshold", "maxRounds"],
      "properties": {
        "threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "maxRounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "stopAfter": {
      "$ref": "#/$defs/text"
    },
    "baselineVersion": {
      "$ref": "#/$defs/version"
    },
    "startingPoint": {
      "enum": [
        "web-3d-world",
        "web-2.5d-world",
        "web-canvas2d",
        "web-pixi",
        "web-three"
      ],
      "description": "Selected source package. Absent in legacy plans means web-3d-world. baselineVersion refers to this package."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-z0-9.-]+)?$"
    },
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "strings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "ownership": {
      "type": "string",
      "description": "A repository-relative file/directory, or a directory ending in /**. No traversal, symlinks, other globs or ownership overlap.",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^*?\\[\\]{}]+(?:/\\*\\*)?$"
    }
  }
}

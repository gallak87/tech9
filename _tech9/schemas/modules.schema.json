{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tech9.local/schemas/modules.schema.json",
  "title": "Tech9 modules",
  "type": "object",
  "required": ["schemaVersion", "modules"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-z0-9.-]+)?$"
          }
        }
      }
    }
  }
}

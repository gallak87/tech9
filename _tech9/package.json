{
  "name": "tech9",
  "version": "3.1.0",
  "private": true,
  "description": "Reusable game modules, authored starting applications and standalone web scaffolds.",
  "type": "module",
  "scripts": {
    "t9": "node tools/tech9.mjs",
    "test": "node --test tests/*.test.mjs modules/*/tests/*.test.js",
    "build": "node tools/build-modules.mjs",
    "check": "npm test && npm run lint && npm run build && npm run t9 -- validate",
    "lint": "eslint tools tests modules scaffolds eslint.config.mjs --max-warnings 0 && npm run format:check",
    "format:check": "prettier --check '*.md' '*.json' '*.mjs' docs tools tests schemas modules scaffolds",
    "format": "prettier --write '*.md' '*.json' '*.mjs' docs tools tests schemas modules scaffolds",
    "lint:staged": "lint-staged",
    "hooks:install": "node tools/install-hooks.mjs",
    "sync:modules": "node tools/sync-modules.mjs",
    "example:vehicles": "vite modules/vehicles/example --host 127.0.0.1 --port 4490 --strictPort",
    "verify:vehicles": "node modules/vehicles/tests/browser.mjs",
    "verify:weather": "node modules/weather/tests/browser.mjs",
    "verify:generation": "node tools/verify-generation.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "playwright": "1.58.2",
    "prettier": "3.9.8",
    "three": "0.186.1",
    "vite": "8.3.0",
    "pixi.js": "8.16.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "lint-staged": {
    "{tools,tests}/**/*.mjs": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "eslint.config.mjs": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{md,json}": "prettier --write",
    "modules/**/src/*.js": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "modules/**/tests/*.js": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ]
  }
}

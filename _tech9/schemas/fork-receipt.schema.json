{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tech9.local/schemas/fork-receipt.schema.json",
  "title": "Tech9 source-fork receipt",
  "description": "Source commit, baseline version and file hashes for a standalone copy.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "status",
    "createdAt",
    "source",
    "plan",
    "ports"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string"
    },
    "status": {
      "const": "scaffolded"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "required": ["path", "commit", "snapshotSha256", "files", "version"],
      "properties": {
        "path": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "snapshotSha256": {
          "$ref": "#/$defs/hash"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "bytes", "sha256"],
            "properties": {
              "path": {
                "type": "string"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "$ref": "#/$defs/hash"
              }
            }
          }
        },
        "version": {
          "type": "string"
        },
        "startingPoint": {
          "type": "string"
        },
        "kind": {
          "enum": ["baseline", "scaffold"]
        },
        "runtime": {
          "const": "web"
        },
        "renderer": {
          "enum": ["canvas2d", "pixi", "three"]
        }
      }
    },
    "plan": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "const": "GAME_PLAN.json"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "ports": {
      "type": "object",
      "required": ["dev", "preview"],
      "properties": {
        "dev": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65534
        },
        "preview": {
          "type": "integer",
          "minimum": 1025,
          "maximum": 65535
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

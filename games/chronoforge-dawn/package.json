{
  "name": "chronoforge-dawn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5190 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 5191 --strictPort",
    "shot": "node tools/shot.mjs",
    "probe": "node tools/probe.mjs",
    "review": "node tools/shot.mjs --w 1920 --h 1080 --quality ultra",
    "lint:rng": "node tools/lintrng.mjs",
    "forge": "node docs/phase2/forge.mjs docs/phase2/forge-manifest.json",
    "forge:test": "node docs/phase2/forge-selftest.mjs",
    "forge:setup": "bash docs/phase2/setup-3dgen.sh",
    "forge:smoke-demo": "bash docs/phase2/forge.sh --image 3d-gen/Hunyuan3D-2.1-mlx/assets/demo.png --output out/smoke-demo.glb --steps 8 --octree-resolution 128",
    "forge:kaida": "bash docs/phase2/forge.sh --image ref/kaida-painterly-raw.png --output out/kaida.glb --steps 50 --octree-resolution 256 --views 6 --texture-size 512",
    "forge:view": "bash docs/phase2/view.sh",
    "retry:gate": "node docs/phase2-retry/gate.mjs",
    "retry:map": "node docs/phase2-retry/tools/suggest-map.mjs",
    "retry:check": "node docs/phase2-retry/tools/check.mjs",
    "retry:engine": "node docs/phase2-retry/test/probe.mjs assets/kaida.glb",
    "retry:all": "npm run retry:gate && npm run retry:engine",
    "retry:prep-mixamo": "blender --background --python docs/phase2-retry/tools/prep-for-mixamo.py -- --input docs/phase2/meshy_output/kaida/kaida.fbx --output docs/phase2-retry/out/kaida-for-mixamo.fbx --tris 24000",
    "retry:probe": "node docs/phase2-retry/test/probe.mjs",
    "retry:shot": "node docs/phase2-retry/tools/ingame.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "vite": "^8.2.2"
  }
}

node_modules/
.DS_Store

# Generated per machine by `npm run mcp:setup` — contains absolute paths to
# the Godot binary and the godot-mcp checkout, so it is not portable.
.mcp.json

# game build output + review captures
games/*/shots/*
!games/*/shots/proto-ref/
games/*/dist/

# Chronoforge Echo development output is temporary, never archived in Git.
games/chronoforge-echo/evidence/
games/chronoforge-echo/experiments/
games/chronoforge-echo/.tmp/
games/chronoforge-echo/test-results/
games/chronoforge-echo/playwright-report/
games/chronoforge-echo/.art-review/
games/chronoforge-echo/docs/town-center-review/

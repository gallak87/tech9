{
  "name": "vector-nova",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5179 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5180 --strictPort",
    "verify": "node tools/verify.mjs",
    "test": "node --test tools/*.test.mjs src/physics/*.test.js src/track/*.test.js src/audio/*.test.js src/environment/*.test.js",
    "lint": "eslint . --max-warnings 0 && npm run format:check",
    "lint:fix": "npm run format && eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:staged": "lint-staged --cwd .",
    "prepare": "cd ../.. && husky games/vector-nova/.husky"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "vite": "8.3.0",
    "playwright": "1.58.2",
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.8"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{css,html,json,md}": "prettier --write"
  }
}

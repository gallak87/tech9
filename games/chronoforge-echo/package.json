{
  "name": "chronforge-echo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4321",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4322",
    "test": "node --test tests/*.test.js",
    "verify": "node tests/browser.mjs",
    "verify:mobile": "node tests/mobile.browser.mjs && node tests/mobile-recovery.browser.mjs",
    "clean:review": "node scripts/review-output.mjs --clean",
    "verify:build": "node scripts/verify-dist.mjs",
    "verify:pages": "npm run build && npm run verify:build && node tests/pages.mjs",
    "lint": "eslint . --max-warnings 0 && npm run format:check",
    "lint:fix": "npm run format && eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:staged": "lint-staged --cwd .",
    "prepare": "cd ../.. && husky games/chronoforge-echo/.husky"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{css,html,json,md}": "prettier --write"
  },
  "dependencies": {
    "pixi.js": "8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "playwright": "1.58.2",
    "prettier": "3.9.8",
    "vite": "8.3.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
